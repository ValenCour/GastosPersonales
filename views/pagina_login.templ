package views

templ PaginaLogin(errorMessage string) {
    <!DOCTYPE html>
    <html lang="es">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>Acceso - Gastos Personales</title>
        <link rel="stylesheet" href="views/styles.css"/>
    </head>
    <body>
        <div class="contenedor-autenticacion">
            
            <div class="item-grid header">
                <header>Gastos Personales</header>
            </div>

            if errorMessage != "" {
                <div class="item-grid error-box">
                    <p class="error-text">{ errorMessage }</p>
                </div>
            }

            <div class="item-grid login-section">
                <h2>Iniciar Sesión</h2>
                <form action="/login" method="POST">
                    <input type="email" name="email" required placeholder="Email"/>
                    <input type="password" name="password" required placeholder="Contraseña"/>
                    <button type="submit">Ingresar</button>
                </form>
            </div>

            <div class="item-grid register-section">
                <h2>Registrarse</h2>
                <form action="/register" method="POST">
                    <input type="text" name="name" required placeholder="Nombre"/>
                    <input type="email" name="email" required placeholder="Email"/>
                    <input type="password" name="password" required placeholder="Contraseña"/>
                    <button type="submit" >Crear Cuenta</button>
                </form>
            </div>
        </div>
    </body>
    </html>
}